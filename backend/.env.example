# Server Configuration
PORT=5000

# JWT Secret Key (generate a random string, min 32 characters)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# MongoDB Atlas Connection URL
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name

# ImageKit Configuration (for resume uploads)
IMAGE_KIT_PUBLIC_KEY=your_imagekit_public_key
IMAGE_KIT_PRIVATE_KEY=your_imagekit_private_key
IMAGE_KIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Environment
NODE_ENV=development
